# SEO Article Writer — Environment Variables
# Copy this file to .env and fill in your keys.
#   cp .env.example .env

# Required: Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: SerpAPI key (https://serpapi.com/)
# Enables live SERP research + Google Image search for article images.
# Without it, Claude knowledge is used and Unsplash search links are provided.
SERPAPI_KEY=

# --- Step 6.5 roster -------------------------------------------------------
# Three roles argue about the article: the writer produces it, the auditor
# attacks it, the judge settles what they cannot. The stage is only worth its
# cost if those roles do not share blind spots, so each extra key you add is
# spent on pushing them onto different vendors.
#
# The auditor is the one that matters most. The judge only ever rules on
# findings the auditor already raised, so a blind spot shared between writer
# and auditor means the finding never exists to be argued about. "auto"
# therefore moves the auditor off Anthropic first, then the judge.
#
#   anthropic only              writer sonnet-5 | auditor opus-5  | judge opus-5
#   + OPENAI_API_KEY            writer sonnet-5 | auditor gpt      | judge opus-5
#   + GEMINI_API_KEY            writer sonnet-5 | auditor gpt      | judge gemini
#
# The writer always stays on Anthropic: the style prompts and sample-article
# matching were tuned against it, so swapping it changes the product rather
# than checking it.

# Optional: OpenAI key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: Google Gemini key (https://aistudio.google.com/apikey)
# Needs: pip install google-genai
GEMINI_API_KEY=

# Optional: pin a role to a vendor. auto | anthropic | openai | gemini
# "auto" picks the most distinct vendor that has a key.
AUDITOR_PROVIDER=auto
JUDGE_PROVIDER=auto

# Optional: the model used when a role runs on that vendor.
# Set these to models your keys can actually reach.
OPENAI_JUDGE_MODEL=gpt-5.5
GEMINI_MODEL=gemini-2.5-pro

# --- Publication identity (SEO/GEO) ----------------------------------------
# Used for the canonical URL, og:url and the Article schema. Left blank, the
# canonical and og:url are omitted rather than guessed: a wrong canonical is
# worse than none at all.
SITE_URL=

# Shown as the author in the HTML head and the Article/Person schema.
AUTHOR_NAME=Imran Tauqir
AUTHOR_URL=https://imrantauqir.com/

# --- Web app -----------------------------------------------------------------
# POST /api/start spends real money: ~15 model calls across three vendors, two
# of them high-effort. Set a password anywhere the app is reachable from the
# internet. Left blank the app runs unprotected, which is fine on localhost and
# is not fine on a public URL.
APP_PASSWORD=
APP_USERNAME=admin

# --- Client workspaces -----------------------------------------------------------
# APP_USERNAME / APP_PASSWORD is the studio owner: an administrator who creates
# client workspaces (the Clients page) and adds people to them with a role.
# Everyone else signs in with their own account. Records live in
# output/_system/humanly.db on the volume.
#
# Encrypts stored client credentials (WordPress application passwords). Leave
# empty and a key is generated once into output/_system/secrets.key; set it to
# keep that key out of the volume. Changing it makes stored passwords unreadable.
SECRETS_KEY=
# Pipelines running at once across all clients (one per workspace at a time).
# Two is safe on a 1 GB machine; video rendering is the heavy one.
MAX_CONCURRENT_JOBS=2
# Server-side refusal fallback for the 5.5 models: "default" (on) or "off".
CLAUDE_FALLBACKS=default
# Delete finished work past each workspace's retention period. Runs on Fly
# automatically; set to 1 to run it elsewhere.
RETENTION_SWEEP=

# --- Topic radar ---------------------------------------------------------------
# "What should I write?" - one research pass over the last two weeks of AI
# videos, podcasts, newsletters and forums, ranked by the gap an engineer-author
# could fill. Run from the button in the app or `python seo_writer.py --radar`.
# Who the radar reads for (steers what counts as a gap):
RADAR_LENS=
# Run it automatically once a week on this day (mon..sun); empty = only on demand.
RADAR_WEEKLY=
# Where the weekly result is POSTed (Zapier/n8n), same payload as /api/radar with callback_url.
RADAR_CALLBACK_URL=
# Optional. Without it the radar reads the tracked channels' Videos pages (rounded
# view counts). With it: exact views and comments, plus a search for the most-viewed
# AI videos from channels it does not follow. Free key, 10,000 units/day; one radar
# run uses about 420. console.cloud.google.com -> APIs -> YouTube Data API v3 -> Credentials.
YOUTUBE_API_KEY=

# --- Voiceover -----------------------------------------------------------------
# --voiceover (or the checkbox) reads the video script's narration aloud in your
# own cloned voice and saves <slug>_voiceover.mp3. Clone your voice once at
# elevenlabs.io (Voices -> Add voice), then paste the voice's ID and an API key.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: eleven_multilingual_v2 (default, best quality) or eleven_flash_v2_5 (cheaper, faster)
ELEVENLABS_MODEL=

# --- Your avatar (Tavus) ------------------------------------------------------------
# --avatar (or "My avatar presents it") has your Tavus replica read the video
# script on camera: <slug>_avatar.mp4. Use your own replica's id, not a stock one.
# Studio workspace only: a client's article is never presented by your face.
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
# Where your live avatar app runs. Each article then gets "Ask Imran about this",
# which opens it briefed on that article.
AVATAR_URL=

# --- Automation callbacks -----------------------------------------------------
# POST /api/start accepts an optional callback_url; the finished-run payload
# links output files through /dl/... URLs signed with an expiring HMAC. The
# links are built from PUBLIC_URL when set, otherwise from the request host.
# Set it on Fly so links never come out as http://localhost.
PUBLIC_URL=
# How long a signed download link stays valid, in seconds (default 7 days).
DOWNLOAD_TTL_SECS=604800

# Optional: override or extend the token price table used by /usage.
# JSON object of {"model": [input_per_mtok, output_per_mtok]}.
# The built-in Anthropic prices are first-party list rates; add your OpenAI and
# Gemini rows here rather than trusting a guess.
# MODEL_PRICES={"gpt-5.5": [1.25, 10.0], "gemini-2.5-pro": [1.25, 10.0]}
