+                     getattr(u, "cache_creation_input_tokens", 0) or 0)
+    text = "\n".join(b.text for b in response.content if getattr(b, "type", "") == "text")
+    if not text.strip():
+        raise ClaudeError("Fact-pack call returned no text.")
+    pack = extract_json(text)
